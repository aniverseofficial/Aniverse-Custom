NODE_ENV=development
PORT=4000

# MongoDB
# Use the full URI from MongoDB Atlas. It must start with mongodb:// or mongodb+srv://
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/
MONGODB_DB=aniverse
PRODUCTS_COLLECTION=products
USERS_COLLECTION=users
ORDERS_COLLECTION=orders
CATEGORIES_COLLECTION=categories

# Admin bootstrap
ADMIN_EMAIL=admin@aniverseofficial.in
ADMIN_PASSWORD=change-this-password
JWT_SECRET=replace-with-a-long-random-secret

# Razorpay Test Mode first
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxx

# Optional
CORS_ORIGIN=http://localhost:4000
ORDER_RESERVATION_MINUTES=15
JSON_LIMIT=2mb

# Optional Shiprocket shipping integration
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_LOCATION=Primary
SHIPROCKET_PICKUP_PINCODE=
SHIPROCKET_CHANNEL_ID=
SHIPROCKET_DEFAULT_WEIGHT=0.5
SHIPROCKET_DEFAULT_LENGTH=20
SHIPROCKET_DEFAULT_WIDTH=15
SHIPROCKET_DEFAULT_HEIGHT=10

# Supplier Stock Report

# ImageKit media storage (public key and endpoint are safe for client use; keep private key secret)
IMAGEKIT_PUBLIC_KEY=public_EsOegPZMYNTArHXHnapJTX7eZ5c=
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/aniverseofficial
IMAGEKIT_PRIVATE_KEY=replace-with-your-imagekit-private-key
# Supplier Stock Report
SUPPLIER_CONFIG_COLLECTION=supplierStockReportConfig
SUPPLIER_CATALOG_PRODUCTS_COLLECTION=supplierCatalogProducts
SUPPLIER_SYNC_RUNS_COLLECTION=supplierSyncRuns
SUPPLIER_MAX_PAGES=120
SUPPLIER_MAX_PRODUCTS=1200
SUPPLIER_DETAIL_CONCURRENCY=6
SUPPLIER_CATALOG_CONCURRENCY=4
SUPPLIER_REQUEST_TIMEOUT_MS=25000
SUPPLIER_IMAGE_TIMEOUT_MS=18000
SUPPLIER_USER_AGENT=AniverseStockReport/1.0
